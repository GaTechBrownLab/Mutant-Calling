/*
Mutant-Calling nextflow config
*/

params {
    //General 
    help                = null
    input_genes         = "data/genes/*.fna"                                                    // Reference genes of interest (ex: PAO1 lasR)
    input_prots         = "data/prot/*.faa"                                                     // Reference proteins of interest (ex: PAO1 LasR)
    input_muts          = "data/mutation_patterns/*.txt"                                        // Mutational pattern of interest (ex: W60R)
    host_genomes        = "data/hosts/*.fna"                                                    // Host genomes to identify potentially mutated genes
    outdir              = "results"                                                             // Output directory
    run_main            = true                                                                  // Run only the main script
    run_graphing        = false                                                                 // Run only the graphing script
    
    // Blast thresholds and options
    tolerance           = "50"                                                                  // When calling incomplete genes, allow for a tolerance of 50 base pairs to ensure insertions are called correctly
    gene_proportion     = "0.05"                                                                // if gene length is greater than gene length * gene length - gene_proportion it is indicative of a complete gene
    split_tolerance     = "5"                                                                   // When calling split genes, allow for a tolerance of 5 base pairs to ensure splits are called correctly
    gene_difference     = "0.4"                                                                 // if gene length is less than gene length * gene_difference it is indicative of a missing gene
    WT_cutoff           = "100"                                                                 // WT must be 100% similar
    mut_cutoff          = "40"                                                                  // Potentially deleted is 40% or less similar

    // Phylogenetic analysis and graphing parameters (INCOMPLETE)
    pres_abs            = true                                                                  // Generate presence absence files
    graphing            = false                                                                 // Generate graphs
    tree                = "data/trees_and_metadata/PA_IQtree_1500_5000.treefile"                // Phylogenetic tree if graphing is enabled
    tree_root           = "GCA_000017205_1_ASM1720v1_genomic"                                   // Root for the phylogenetic tree if graphing is enabled
    fastani             = "data/trees_and_metadata/fastani_output_cleaned.csv"                  // FastANI of individuals in the tree if graphing is enabled
    env_data            = "data/trees_and_metadata/genome_annotations_classified.csv"           // Associated environmental metadata if graphing is enabled
    lineage_probability = "0.9"                                                                 // The probability of a node's state being present must be over 0.9 to be in a lineage
    
    // ANI clustering parameters
    ani_clusters        = false                                                                 // Generate graphs
    ani_start           = 99.5                                                                  // ANI starting threshold
    ani_end             = 99.99                                                                 // ANI ending threshold
    ani_steps           = 15                                                                    // ANI steps
    
    // run_graphing parameters
    incomplete_ran      = "results/ouputs_for_graphing/*/*_functions_incomplete.csv"            // Set path for functions for graphing              
    pa_incomplete_ran   = "results/ouputs_for_graphing/*/*_functions_pres_abs_incomplete.csv"   // Set path for presence absence matrix for graphing
    no_funct_clusters   = "results/ani_cluster_function/*/*_no_funct_clusters_env.csv"          // Set up path for non-functional clusters per environment

    // Performance options
    blast_threads       = "10"                                                                  // Blast threads

}

conda {
    enabled = true
    useMicromamba = true
}

executor {
    name = 'local'
    cpus = 50    // Leave some headroom (e.g. 200 out of 256)
}

env {
    OMP_NUM_THREADS        = 1   // Prevent numpy/scipy/OpenBLAS spinning up all cores
    OPENBLAS_NUM_THREADS   = 1
    MKL_NUM_THREADS        = 1
    NUMEXPR_NUM_THREADS    = 1
}

executor {
name = 'local'
cpus = 50
}

process {
    conda = "${projectDir}/envs/mutant_calling.yaml"
    cpus = 1
    maxForks = 20  // Default concurrency cap for unlabeled processes
    errorStrategy = 'retry'
    maxRetries = 3

    withLabel: 'blast' {
        cpus = params.blast_threads
        maxForks = 3   // BLAST is CPU-hungry, limit concurrency
    }
    withLabel: 'light' {
        cpus = 1
        maxForks = 10  // Lighter processes can run more freely
    }
    withLabel: 'r_graphing' {
        conda = "${projectDir}/envs/r_tools.yaml"
        cpus = 1
        maxForks = 10
    }
}

profiles {
    standard {
        process.executor = 'local'
    }
}
    
