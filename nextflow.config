/*
Mutant-Calling nextflow config
*/

params {
    input_genes         = "/data2/I_Irby/Mutant-Calling/data/genes/*.fna"                                             // Reference genes of interest (ex: PAO1 lasR)
    input_prots         = "/data2/I_Irby/Mutant-Calling/data/prot/*.faa"                                              // Reference proteins of interest (ex: PAO1 LasR)
    input_muts          = "/data2/I_Irby/Mutant-Calling/data/mutation_patterns/*.txt"                                 // Mutational pattern of interest (ex: W60R)
    host_genomes        = "/data2/I_Irby/Mutant_Calling_Nextflow/Code/data/hosts/*.fna"                                             // Host genomes to identify potentially mutated genes
    tree                = "/data2/I_Irby/Mutant_Calling_Nextflow/Code/data/trees_and_metadata/iqtree_new_1500_5000_max.contree"     // Phylogenetic tree if graphing is enabled
    tree_root           = "GCA_000017205_1_ASM1720v1_genomic"                                                                       // Root for the phylogenetic tree if graphing is enabled
    fastani             = "/data2/I_Irby/Mutant_Calling_Nextflow/Code/data/trees_and_metadata/fastani_output_cleaned.csv"           // FastANI of individuals in the tree if graphing is enabled
    env_data            = "/data2/I_Irby/Mutant_Calling_Nextflow/Code/data/trees_and_metadata/genome_annotations_classified.csv"    // Associated environmental metadata if graphing is enabled
    lineage_probability = "0.9"                                                                                                     // The probability of a node's state being present must be over 0.9 to be in a lineage
    blast_threads       = "25"                                                                                                      // Blast threads
    outdir              = "results"                                                                                                 // Output directory
    tolerance           = "50"                                                                                                      // When calling incomplete genes, allow for a tolerance of 50 base pairs to ensure insertions are called correctly
    gene_proportion     = "0.05"                                                                                                    // if gene length is greater than gene length * gene length - gene_proportion it is indicative of a complete gene
    split_tolerance     = "5"                                                                                                       // When calling split genes, allow for a tolerance of 5 base pairs to ensure splits are called correctly
    gene_difference     = "0.4"                                                                                                     // if gene length is less than gene length * gene_difference it is indicative of a missing gene
    WT_cutoff           = "100"                                                                                                     // WT must be 100% similar
    mut_cutoff          = "40"                                                                                                      // Potentially deleted is 40% or less similar
    ani_start           = 99.5                                                                                                      // ANI starting threshold
    ani_end             = 99.99                                                                                                     // ANI ending threshold
    ani_steps           = 15                                                                                                        // ANI steps
    pres_abs            = true                                                                                                      // Generate presence absence files
    graphing            = true                                                                                                      // Generate graphs
    ani_clusters        = true                                                                                                      // Generate graphs
    run_main            = true
    run_graphing        = false
    incomplete_ran      = "/data2/I_Irby/Mutant-Calling/results/ouputs_for_graphing/*/*_functions_incomplete.csv"
    pa_incomplete_ran   = "/data2/I_Irby/Mutant-Calling/results/ouputs_for_graphing/*/*_functions_pres_abs_incomplete.csv"
    no_funct_clusters   = "/data2/I_Irby/Mutant-Calling/results/ani_cluster_function/*/*_no_funct_clusters_env.csv"
}

conda {
    enabled = true
}

process {
    conda = "${projectDir}/envs/mutant_calling.yaml"
    cpus = 50
}

profiles {
    standard {
        process.executor = 'local'
        // process.errorStrategy = 'retry'
        // process.maxRetries = 3
    }
}
    